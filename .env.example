# Copy to .env and fill in. Never commit .env.

# IBKR Gateway (paper)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=7
IBKR_EXEC_CLIENT_ID=18
PAPER_TRADING=true
BROKER=ibkr

# Proof capital / risk ceiling (AUD)
# Risk sizes against min(broker NetLiquidation USD, PORTFOLIO_VALUE_AUD / USD_AUD).
# USD_AUD = AUD per 1 USD (approx FX; update periodically — not a live feed).
PORTFOLIO_VALUE_AUD=10000
USD_AUD=1.52
# Optional explicit USD override (skips AUD→USD). Prefer PORTFOLIO_VALUE_AUD.
# PORTFOLIO_VALUE_USD=

# Telegram (optional until filled)
NOTIFY_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Watchlist auto-refresh (session_runner prefilter_tick)
# Refresh when missing, empty, not today (ET), or older than this many hours.
WATCHLIST_STALE_HOURS=12

# Ledger / dashboard
LEDGER_DB_PATH=data/ledger.sqlite3
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
