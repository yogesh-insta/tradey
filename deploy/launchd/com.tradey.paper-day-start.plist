<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent: start US paper day at 21:30 local Mac clock (AEST/AEDT).

  Weekday evenings so you can verify Bot status on the dashboard before bed.
  Runner idles in too_early / prefilter until US RTH; default is dry-run.
  Sequential with ASX daytime agents (09:30 start / 16:30 stop).

  Install (once):
    cp deploy/launchd/com.tradey.paper-day-start.plist ~/Library/LaunchAgents/
    # Edit ProgramArguments path if repo is not /Users/ym/mws26/tradey
    launchctl load ~/Library/LaunchAgents/com.tradey.paper-day-start.plist

  Unload:
    launchctl unload ~/Library/LaunchAgents/com.tradey.paper-day-start.plist

  Pair with com.tradey.paper-day-stop.plist (~09:00) or run ./scripts/stop_paper_day.sh --market us.
  IB Gateway login remains manual.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tradey.paper-day-start</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ym/mws26/tradey/scripts/start_paper_day.sh</string>
    <string>--market</string>
    <string>us</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ym/mws26/tradey</string>
  <key>StartCalendarInterval</key>
  <array>
    <!-- Mon–Fri 21:30 local -->
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>21</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>21</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>21</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>21</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>21</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/ym/mws26/tradey/logs/launchd-start.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ym/mws26/tradey/logs/launchd-start.err.log</string>
  <key>RunAtLoad</key>
  <false/>
  <!-- Keep nohup'd dashboard/runner/caffeinate alive after start script exits -->
  <key>AbandonProcessGroup</key>
  <true/>
</dict>
</plist>
